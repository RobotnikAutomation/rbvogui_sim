repositories:
  rbvogui_common:
    type: git
    url: https://github.com/RobotnikAutomation/rbvogui_common
    version: feat/gazebo_ignition
  rbvogui_sim:
    type: git
    url: https://github.com/RobotnikAutomation/rbvogui_sim
    version: feat/gazebo_ignition
  realsense_gazebo_plugin:
