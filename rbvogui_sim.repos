    version: foxy-devel
  robotnik_controllers:
    type: git
    url: https://github.com/RobotnikAutomation/robotnik_controllers/
    version: ros2-devel
  robotnik_msgs:
    type: git
    url: https://github.com/RobotnikAutomation/robotnik_msgs
    version: ros2-devel
  robotnik_sensors:
    type: git
    url: https://github.com/RobotnikAutomation/robotnik_sensors
    version: feat/gazebo_ignition
