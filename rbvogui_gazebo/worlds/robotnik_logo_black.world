<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="ros_logo">
    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Luz principal -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- NUMERO 1 -->
    <!-- BLOQUE DERECHO-->
    <model name="wall_D_3_1">
      <static>true</static>
      <pose>3 1.05 1 0 0 0</pose>
      <link name="link"><collision name="wall"><laser_retro>255</laser_retro>
        <geometry><cylinder><radius>0.25</radius><length>2.0</length></cylinder></geometry></collision>
      <visual name="vis"><geometry><cylinder><radius>0.25</radius><length>2.0</length></cylinder></geometry>
      <material><ambient>0.0 0.0 0.0 1</ambient><diffuse>0.0 0.0 0.0 1</diffuse></material></visual></link>
